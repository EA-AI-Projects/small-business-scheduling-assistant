# Public build-time settings only; never put secrets here. Copy to .env.local for local dev.
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BUSINESS_ID=pilot
# Cognito mode (Amplify builds):
# NEXT_PUBLIC_AUTH_MODE=cognito
# NEXT_PUBLIC_API_BASE_URL=https://<owner-api-id>.execute-api.us-west-1.amazonaws.com
# NEXT_PUBLIC_COGNITO_DOMAIN=https://<prefix>.auth.us-west-1.amazoncognito.com
# NEXT_PUBLIC_COGNITO_CLIENT_ID=<public app client id>
